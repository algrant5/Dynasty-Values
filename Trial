name: Update data
on:
  schedule:
    - cron: "0 10 * * 2,5"   # Tuesdays and Fridays, 10:00 UTC
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install nfl_data_py requests pandas
      - run: python update_data.py
      - run: |
          git config user.name "data-bot"
          git config user.email "bot@users.noreply.github.com"
          git add data.json
          git commit -m "Update data" || echo "no changes"
          git push
